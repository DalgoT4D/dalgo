    {
      "id": "claim_0b97538480334284921451d2a1031613",
      "statement": "Chart data for saved charts and unsaved builder configs goes through `generate_chart_data_and_config`, which builds a query for the chart's schema and table, executes it through a WarehouseFactory-backed client on every request, and returns data plus an ECharts config. Maps and pivot tables use separate branches. A missing OrgWarehouse returns 404, ValueErrors map to 400 and other errors to 500.",
      "evidence": [
        {
          "resource": "repo://backend/ddpui/api/charts_api.py#L148-L220",
          "version": "repo-lines-v1:sha256:e227b536703b7481599685b2143ba7a0bf252e47aee75e28d46c3e87d39a87b1:"
