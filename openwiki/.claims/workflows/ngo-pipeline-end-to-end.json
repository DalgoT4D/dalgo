    {
      "id": "claim_857cadeef54f4a7d8b097380f5ddbd6d",
      "statement": "The /pipeline run-history page is fed by `GET /api/dashboard/v1`, which returns each orchestrate pipeline with up to 50 recent Prefect runs and its lock owner.",
