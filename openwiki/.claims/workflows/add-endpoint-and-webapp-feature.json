    {
      "id": "claim_a5e2480de80a42cf9ec0c7b2453afc1c",
      "statement": "Every new endpoint needs a new slug added in two seed files: backend/seed/002_permissions.json (a Permission row with a unique pk; the KPI slugs are pk 78-81) and backend/seed/003_role_permissions.json (RolePermission rows referencing role and permission by numeric pk, e.g. can_view_kpis pk 78 granted to roles 1, 2, 4, 5).",
      "evidence": [
        {
          "resource": "repo://backend/seed/001_roles.json",
          "version": "repo-file-v1:sha256:370fe180b98cecdc0ebef92c0f2bbfb3c55b2e85bca616f3e384fac4bc3fa8b8"
