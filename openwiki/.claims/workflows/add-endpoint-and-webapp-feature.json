    {
      "id": "claim_c999e029dae44dc1afb118f13e367764",
      "statement": "has_permission requires request.permissions to be a superset of the listed slugs and converts its own 403 into HTTP 404 'unauthorized', so a missing seed row or grant shows up as 'not found' rather than 'forbidden'.",
      "evidence": [
        {
          "resource": "repo://backend/ddpui/auth.py#L41-L75",
          "version": "repo-lines-v1:sha256:317a6ad3c29501e185a3b775f99cfebf2efd56e9135f379b2e4ba116c8135364:"
        }
      ]
    },
    {
      "id": "claim_6337570ed6e346d98e898721bca62694",
      "statement": "has_access is stacked under has_permission for individually shareable resources; it requires a get_resource_id callable, returns 404 for missing or cross-org resources, 403 for no access or insufficient level, and sets request.access_level, which kpi_api uses when building responses.",
      "evidence": [
        {
          "resource": "repo://backend/ddpui/api/kpi_api.py#L113-L125",
