        }
      ]
    },
    {
      "id": "claim_816e386a89eb43d9b9c01800e61008a2",
      "statement": "Permissions are resolved from Redis: a per-user {orguser_id: role_id} map under the token's orguser_role_key claim and a {role_id: [permission slugs]} map under ROLE_PERMISSIONS_REDIS_KEY (default dalgo_permissions_key). Missing or corrupt entries are rebuilt from the RolePermission table, and the middleware sets request.user, orguser, permissions and token.",
      "evidence": [
        {
          "resource": "repo://backend/ddpui/auth.py#L126-L136",
          "version": "repo-lines-v1:sha256:3bb9d3f37a2bcc7218fa64d88c3e045d4db52c5054511145427f88e95b5a96b0:"
