        }
      ]
    },
    {
      "id": "claim_65779ffa76064b64b6f51879762b8cbc",
      "statement": "CustomTokenObtainSerializer.get_token rebuilds the user's orguser-to-role map in Redis on every login and refresh, seeds the role-permission map if absent, and adds the orguser_role_key claim; the v2 login and refresh endpoints deliver tokens as httpOnly cookies configured by COOKIE_* settings, and logout blacklists both tokens and deletes the cookies.",
      "evidence": [
        {
          "resource": "repo://backend/ddpui/api/user_org_api.py#L1277-L1358",
