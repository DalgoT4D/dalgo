    {
      "id": "claim_6e8b414d29274ae0a037598e5a10eccf",
      "statement": "CustomJwtAuthMiddleware is the default auth of the main NinjaAPI, so every route is authenticated unless it opts out with auth=None; it reads the access_token cookie first and falls back to bearer auth. An expired token yields HTTP 498 (the frontend refreshes), while malformed or bad-signature tokens yield 401.",
      "evidence": [
        {
          "resource": "repo://backend/ddpui/auth.py#L154-L172",
          "version": "repo-lines-v1:sha256:f22370ebe630514f41e36a9716d6ac6f7ef58b3cad70840e9ca556ccc94cdf82:"
        },
        {
          "resource": "repo://backend/ddpui/routes.py#L34-L40",
          "version": "repo-lines-v1:sha256:da180e916342435101a24921fbaebf8fa78bdbfce5c158b88b1105812e29df4d:"
        }
      ]
    },
    {
      "id": "claim_d241522326594e8f9e60be715926196a",
      "statement": "authenticate() rejects tokens whose jti is blacklisted in Redis (blacklisted_jti:<jti>, TTL equal to remaining lifetime, written at logout), then resolves the OrgUser for the token's user_id narrowed by the x-dalgo-org org slug header when present (else the user's first OrgUser); an OrgUser with no org gives 400 and no match gives 401.",
      "evidence": [
        {
          "resource": "repo://backend/ddpui/api/user_org_api.py#L239-L269",
          "version": "repo-lines-v1:sha256:1548d996f7fa054f4142350efbec23b06bfccf7184b2e6086ca0192626118638:"
