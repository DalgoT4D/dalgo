    {
      "id": "claim_523070a5c6bf43e993b779c55751aacf",
      "statement": "The job-runner image is built from `prefecthq/prefect:<PREFECT_VERSION>-python3.10-kubernetes`, installs dependencies by exporting prefect-proxy's `uv.lock` to requirements (single source of truth), uses `prefect-proxy/` as build context, does not bake in code (workers clone the monorepo at flow-run time), and must keep PREFECT_VERSION aligned with the `prefect==` pin.",
      "evidence": [
