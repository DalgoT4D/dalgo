    {
      "id": "claim_b1c25f045aa543aeafeb1dc717a1d81b",
      "statement": "Dockerfiles for backend, prefect-proxy, ai-llm-service and webapp use the monorepo root as build context; backend and proxy are two-stage uv builds that sync from lockfiles with `--frozen`, and the backend image runs as `dalgouser` pinned to UID/GID 1000 so bind-mounted host directories have predictable ownership.",
      "evidence": [
        {
          "resource": "repo://docker/Dockerfile.ai-llm-service",
          "version": "repo-file-v1:sha256:ebe47b7d3695b658d4e21782d9a2b4baeb3d6ae4a6a74b1e7cdce948244ecb4c"
        },
