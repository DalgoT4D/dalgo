    {
      "id": "claim_a84940021a4648699cbf358d306897ee",
      "statement": "deployment_schedule_flow_v5 sorts tasks by seq and dispatches by block type and slug; by default it runs tasks sequentially fail-fast with a 10s sleep between tasks, and with continue_on_sync_failure it runs all Airbyte syncs first, collecting errors and raising before any transform task runs.",
