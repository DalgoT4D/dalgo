  "claims": [
    {
      "id": "claim_89e5bcf7ed2c4cbe8caacb0d959e4e18",
      "statement": "The backend reaches Prefect only through prefect-proxy: prefect_service wraps requests to {PREFECT_PROXY_API_URL}/proxy/{endpoint}, attaches an x-ddp-org header, applies PREFECT_HTTP_TIMEOUT (default 30s), and converts connection failures into HttpError 500 and non-2xx responses into HttpError carrying the proxy status.",
      "evidence": [
        {
          "resource": "repo://backend/ddpui/ddpprefect/prefect_service.py#L149-L192",
          "version": "repo-lines-v1:sha256:072b996b5e83272d108894b54f21848010c24a188a74506b6113208dd300ecc7:"
        },
        {
          "resource": "repo://backend/ddpui/ddpprefect/prefect_service.py#L42-L96",
          "version": "repo-lines-v1:sha256:e599a190a1a84f115ed388a8853f48fb19ddd4043cd8769b21ff4b04fc59524c:"
        }
      ]
    },
    {
      "id": "claim_1813002ba57f4e279efdd1005187d1c1",
      "statement": "prefect-proxy creates deployments from git source (DalgoT4D/dalgo.git, branch PREFECT_PROXY_GIT_BRANCH default main, sparse directory prefect-proxy) with entrypoint prefect_flows_runner.py:deployment_schedule_flow_v5, build=False/push=False, org-slug tag, default queue 'ddp' and pool 'default-agent-pool', and an optional active cron schedule, so workers load flow code from git at run time.",
      "evidence": [
        {
          "resource": "repo://backend/ddpui/ddpprefect/prefect_service.py#L357-L373",
          "version": "repo-lines-v1:sha256:7840b230947bb7162db2864dee071f7748e6a0e76b410c77de7cbc5ef7deb50e:"
        },
        {
