    {
      "id": "claim_528a6952040d4d7e9f28de66f4b57803",
      "statement": "Alert delivery returns per-target delivery dicts stored in AlertLog.deliveries: email goes through notify_alert_recipients (SES, expands orguser and user_group recipients, deduplicates by email address, records unresolvable recipients as failed), and Slack POSTs {'text': body} to the per-alert webhook with a 10s timeout, with non-2xx or request errors recorded as failed.",
      "evidence": [
        {
          "resource": "repo://backend/ddpui/core/alerts/delivery.py#L35-L86",
