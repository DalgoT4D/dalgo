    {
      "id": "claim_d43d7e13a8db4a1290a11b59b2fc78c8",
      "statement": "Condition semantics: a None value (no rows) never fires; kpi_rag fires when the computed RAG state is in the selected 1-2 rag_states; metric_threshold and standalone alerts compare the float value with lt, gt or eq. There is no cooldown or state-change deduplication, so a persistently firing alert notifies on every scheduled evaluation.",
      "evidence": [
        {
          "resource": "repo://backend/ddpui/celeryworkers/alert_tasks.py#L114-L130",
          "version": "repo-lines-v1:sha256:b57352c817659192f13e441025dbded463114bdbd96bc90fcdafd396e9f8adb8:"
