    {
      "id": "claim_deade8788ffa4ab788242deba4454a85",
      "statement": "Alerts are evaluated on a per-alert UTC cron schedule: a 60-second beat tick runs dispatch_due_alerts, which enqueues evaluate_alert for each active alert whose most recent cron tick is later than last_evaluated_at (falling back to created_at); both tasks are routed to a dedicated 'alerts' Celery queue.",
      "evidence": [
        {
          "resource": "repo://backend/ddpui/celery.py#L38-L47",
          "version": "repo-lines-v1:sha256:39958b0379fcf1688b03818db6bc5ace4aec954cc492de6bb8eefbf1ed225d56:"
        },
        {
          "resource": "repo://backend/ddpui/celeryworkers/alert_tasks.py#L38-L55",
          "version": "repo-lines-v1:sha256:b1af60dc1f4b605f548210a6100fead4fb9e563b64acbd40feadc3ba20602af5:"
