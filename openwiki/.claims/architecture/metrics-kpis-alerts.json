    {
      "id": "claim_6d297ff64f13488c9637a864aba1ec38",
      "statement": "Alert value computation reuses the Metric and KPI services: metric_threshold calls MetricService.compute_metric_value_with_sql, kpi_rag calls KPIService.compute_latest_value (most recent time-grain period with RAG status, falling back to a whole-dataset aggregate when the KPI has no time column/grain), and standalone builds an AggQueryBuilder query from standalone_config with eq/neq/gt/lt/gte/lte filters.",
      "evidence": [
        {
          "resource": "repo://backend/ddpui/core/alerts/alert_query.py#L47-L119",
          "version": "repo-lines-v1:sha256:b8b8c7b2d13912564141ab772fb9e287f188a5505ce4638bd2ed3ab49ee683c0:"
