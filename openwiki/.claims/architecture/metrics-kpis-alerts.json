    {
      "id": "claim_0040eb2e89a34b58a8256e0adce405e5",
      "statement": "_run_evaluation always writes one immutable AlertLog row per evaluation (fired or not), including value, frozen alert_snapshot (with rag_status and an error key on failure), executed SQL, rendered message and deliveries; a missing warehouse or query exception yields fired=False with the error recorded instead of crashing, and delivery only runs when fired.",
      "evidence": [
        {
          "resource": "repo://backend/ddpui/celeryworkers/alert_tasks.py#L97-L162",
