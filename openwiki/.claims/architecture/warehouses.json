    {
      "id": "claim_29dd4bef620d4ab0b686c89d6f468066",
      "statement": "A lazily started daemon sweeper thread (started on first engine use, because gunicorn/celery fork workers) wakes every 300s and disposes engines idle over 600s, skipping engines with checked-out connections or no idle sockets; disposal keeps the registry entry so the engine reopens connections later, and entries are never removed from the registry.",
      "evidence": [
        {
          "resource": "repo://backend/ddpui/tests/utils/warehouse/test_postgres_engine_registry.py#L160-L272",
          "version": "repo-lines-v1:sha256:3d2b1313a7cb06b97c72e7477bb1c3cf68f2f6de2e0734977bea97fe41db244e:"
        },
        {
