    {
      "id": "claim_062850f7f2b3448a879748be1eda35aa",
      "statement": "PostgresClient does not create an engine per instance: it fingerprints the full credentials (SHA-256 over sorted JSON, scoped by warehouse type) and obtains a shared pooled SQLAlchemy engine from the process-local postgres_engine_registry, so distinct databases get distinct engines and rotated credentials get a new engine.",
      "evidence": [
        {
          "resource": "repo://backend/ddpui/utils/warehouse/client/postgres.py#L15-L35",
          "version": "repo-lines-v1:sha256:0245e6f6bce6750306622a13b9ee3fd6ba5a802fb38d68bb38c8e98810523eb1:"
        },
        {
          "resource": "repo://backend/ddpui/utils/warehouse/client/postgres_engine_registry.py#L186-L212",
          "version": "repo-lines-v1:sha256:f912c17629c149c00b8fa7ef6265bba6f93e9c16e877771edec379ec92c982ac:"
        },
        {
          "resource": "repo://backend/ddpui/utils/warehouse/client/postgres_engine_registry.py#L96-L106",
          "version": "repo-lines-v1:sha256:b7f80452bc61b6185e6c91a2815b37f67ee7e05c6d249cb9556fe903c3a53049:"
        }
      ]
    },
    {
      "id": "claim_e580a5b045de4b9b947a1e133a75cae5",
      "statement": "The Postgres engine registry bounds connections with pool_kwargs (pool_size from WAREHOUSE_POOL_SIZE default 5, max_overflow 7, pool_timeout 30, pool_pre_ping), uses per-key locks so engine creation for one org never blocks others, and the peak connections per warehouse is n_processes times pool size plus overflow.",
      "evidence": [
        {
          "resource": "repo://backend/ddpui/utils/warehouse/client/postgres_engine_registry.py#L1-L38",
          "version": "repo-lines-v1:sha256:3dc68246681a4dd9326c2b0b18f98b2bf6a20157c363517dabd2ddea6a6b8d77:"
        },
