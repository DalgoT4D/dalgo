          "version": "repo-lines-v1:sha256:34f166db08e11a2736e400652839b01e4720d4660c9a4c430e54df79f1cac150:"
        }
      ]
    },
    {
      "id": "claim_a75c0ca3b3f74b87a79581de12192006",
      "statement": "Endpoints that run before a user context exists opt out of JWT auth with auth=None (login, token refresh, password reset, invite accept, the Airbyte OAuth callback). The Prefect and Airbyte webhooks authenticate by comparing an X-Notification-Key header to an environment variable, then queue Celery tasks.",
      "evidence": [
        {
          "resource": "repo://backend/ddpui/api/user_org_api.py#L201-L202",
          "version": "repo-lines-v1:sha256:a6dde24a9772b51ccdb54bbd707acbe55755454e35115c7f52816459cad5d2fe:"
