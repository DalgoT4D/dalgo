    {
      "id": "claim_b77dded85243431cbecdf343797189ae",
      "statement": "CustomLogger is a thin subclass of DalgoLogger. It emits structured JSON, sends records up to WARNING to stdout and ERROR and above to stderr, and disables propagation. A rotating file handler is added only when ENABLE_FILE_LOGGING=True. Org slug and user id are auto-detected by scanning up to 10 stack frames for local variables named orguser, org or user. There is no request-id middleware, so request_id appears only if a caller passes it in extra.",
      "evidence": [
        {
          "resource": "repo://backend/ddpui/settings.py#L117-L131",
          "version": "repo-lines-v1:sha256:aedf1b7c9b6101332cdae414d6e2cb5bc0731719a84ceb5eead043145b749165:"
