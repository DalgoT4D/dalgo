    {
      "id": "claim_85d6240846044a89a94e35f09c8b9879",
      "statement": "The documented non-negotiable invariants are: API → core → models, org-filtered queries, @has_permission on every endpoint, api_response returns, extra=\"forbid\" schemas validating before dbt/Airbyte/Prefect calls, top-of-file imports only, no to_json/to_dict on models, empty core feature __init__.py, service signatures of payload schema plus org/orguser, and exception chaining with from err.",
      "evidence": [
