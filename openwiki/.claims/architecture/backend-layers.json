    {
      "id": "claim_fd1979a106a0445e9ace86528aea92b5",
      "statement": "api_response(success, data, message) returns a plain dict envelope. message and data are omitted when None, and data is model_dumped if it is a schema instance. ApiResponse[T] is the matching generic schema for OpenAPI response typing.",
      "evidence": [
        {
          "resource": "repo://backend/ddpui/utils/response_wrapper.py#L8-L42",
          "version": "repo-lines-v1:sha256:e241a914a21e032a3020fc901b127fe22bc88bffb55d2965078eff1092de73b6:"
        }
      ]
    },
    {
      "id": "claim_495fb4a74afb4eb19bae9b393904f02b",
      "statement": "api_response is not applied universally. Only alert_api, chat_with_data_api, kpi_api, metric_api, report_api and user_org_api reference it. Other routers, including pipeline_api and the webhooks, return service results, response schemas or plain dicts directly, so the envelope rule is a target for new endpoints rather than a property of the whole API.",
      "evidence": [
