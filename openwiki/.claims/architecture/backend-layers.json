    {
      "id": "claim_4684d90012d945789bc056c155734703",
      "statement": "routes.py builds the main NinjaAPI (src_api) with CustomJwtAuthMiddleware as the default auth, so every mounted router is authenticated unless an endpoint sets auth=None. It imports each module's router, tags it for the OpenAPI docs, and mounts it with add_router under prefixes such as /api/airbyte/, /api/prefect/ (pipeline_router), /api/prefect/tasks/, /api/kpis/, /webhooks/ and /api/ (user_org_router). A second unauthenticated NinjaAPI, public_api, serves the public and trial routers.",
      "evidence": [
        {
          "resource": "repo://backend/ddpui/routes.py#L100-L134",
          "version": "repo-lines-v1:sha256:4c207aaef47e3a5d9323d59b45cdaceafd0a0542bd30106257ceaa0a521649c2:"
        },
        {
          "resource": "repo://backend/ddpui/routes.py#L34-L40",
          "version": "repo-lines-v1:sha256:da180e916342435101a24921fbaebf8fa78bdbfce5c158b88b1105812e29df4d:"
        }
      ]
    },
    {
      "id": "claim_033e687d558c4bb29736aa286084caad",
      "statement": "urls.py mounts src_api.urls and public_api.urls at the empty path, alongside admin, healthcheck, prometheus and dbt docs routes. WebSocket consumers (data insights, Airbyte checks, chat-with-data) are declared in ws_urlpatterns in the same file.",
      "evidence": [
        {
          "resource": "repo://backend/ddpui/urls.py#L24-L44",
          "version": "repo-lines-v1:sha256:6e1f64c3980a49fbc6420ba2440366a72f584672e94bcf19c7745e754f7dbde5:"
        }
      ]
