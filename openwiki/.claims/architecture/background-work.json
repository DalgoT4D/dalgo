    {
      "id": "claim_68fb08785bcc4026bfa97bb3d403abb7",
      "statement": "Celery routes run_dbt_commands to the canvas_dbt queue, trial clone and expired-trial deletion to trial_clone, and alert dispatch/evaluation to the alerts queue; everything else uses default. Compose files run workers for default, canvas_dbt and alerts plus a RedBeat beat process but no trial_clone consumer.",
      "evidence": [
