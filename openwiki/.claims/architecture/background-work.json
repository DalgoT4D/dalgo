    {
      "id": "claim_dd73664910604403a7cb600b7f1a9928",
      "statement": "TaskProgress stores a JSON list of steps in a Redis hash (hashkey, field task_id) via RedisClient.get_instance(); the first add overwrites prior state for that task id, and expiry is set once on the first add for the whole hash only when expire_in_seconds is given.",
      "evidence": [
        {
          "resource": "repo://backend/ddpui/utils/taskprogress.py#L8-L49",
          "version": "repo-lines-v1:sha256:6636eb7a1312eabcf2ad9dc2792a6c1c46c4a59bea9bc0c556aec932647de2ef:"
        }
      ]
    },
    {
      "id": "claim_f933b4e04988499e9167e3ec1a22b395",
      "statement": "SingleTaskProgress stores a JSON list under a single Redis key; its constructor resets the key to an empty list with a TTL, add preserves the remaining TTL, and the key disappears only by expiry, so fetch returning None means not started or expired.",
      "evidence": [
        {
          "resource": "repo://backend/ddpui/utils/singletaskprogress.py#L7-L48",
          "version": "repo-lines-v1:sha256:1098f3e2bc9a8c7acd22e249f790861326028ec316da20a1463e4c1c5a0fc09e:"
        }
      ]
    },
