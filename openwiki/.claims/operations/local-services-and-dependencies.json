    {
      "id": "claim_103c6e4cbec1488fbfee4513a9d6cc66",
      "statement": "The dev compose stack (project name dalgo) runs two separate Redis instances (redis for backend Celery, redis-llm for ai-llm-service), Prefect server, prefect-proxy, two Prefect workers on the ddp and manual-dbt queues, the backend, four Celery containers (default, canvas_dbt, alerts, beat), the webapp and ai-llm-service with its own Celery worker, while Postgres runs on the host reached via host.docker.internal.",
      "evidence": [
        {
          "resource": "repo://docker/docker-compose.dev.yml#L1-L220",
          "version": "repo-lines-v1:sha256:cffeffe146acb585993e8c10c044014fc3612c26395b5f3d9aa874592e851bf6:"
        }
      ]
    },
