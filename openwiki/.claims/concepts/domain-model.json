    {
      "id": "claim_64edff7669f040b7ad0c50603bda1d14",
      "statement": "A pipeline is not a single table: it is an OrgDataFlowv1 (Prefect deployment id, cron, dataflow_type orchestrate or manual) plus ordered DataflowOrgTask rows (with seq) linking it to OrgTask instances of the global Task catalogue. OrgTask carries the Airbyte connection_id as a string, an optional dbt FK, parameters and post_sync_transform, and TaskLock is one-to-one with OrgTask to prevent concurrent runs.",
      "evidence": [
        {
          "resource": "repo://backend/ddpui/models/org.py#L308-L335",
