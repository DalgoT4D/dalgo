    {
      "id": "claim_0e31fc0da62544dcb0f41e7445ddfb93",
      "statement": "Tenant scoping is a per-query convention rather than an ORM or tenant-aware manager mechanism: the OrgUser is resolved from the JWT and x-dalgo-org header (Org.slug), and services and endpoints repeat org=orguser.org in their filters. Public share routes have no OrgUser and instead derive the org from the shared dashboard or snapshot (org=dashboard.org or org=snapshot.org) when loading charts and the warehouse.",
      "evidence": [
        {
          "resource": "repo://backend/ddpui/api/public_api.py#L210-L280",
