    {
      "id": "claim_08b534f0bbc1493c87c983c9728cd675",
      "statement": "Deletion semantics for metrics and alerts: KPI.metric is on_delete=PROTECT so a Metric with KPIs cannot be deleted, while Alert.metric and Alert.kpi are CASCADE (and AlertLog cascades from Alert), so deleting a Metric or KPI silently removes its alerts and logs. Metric names are unique per org and alert names are unique per org.",
      "evidence": [
        {
          "resource": "repo://backend/ddpui/models/alert.py#L117-L130",
