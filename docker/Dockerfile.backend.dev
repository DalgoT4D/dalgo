# ── Builder ───────────────────────────────────────────────────────────────────
FROM ghcr.io/astral-sh/uv:python3.10-bookworm-slim AS builder

ENV PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_DOWNLOADS=never \
    UV_COMPILE_BYTECODE=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential libpq-dev git \
    && rm -rf /var/lib/apt/lists/*

# Deps-only layer — only invalidated when lockfile changes.
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-install-project

# Full sync with editable install pointing to /app.
COPY backend/ .
RUN uv sync --frozen

# ── Runtime ───────────────────────────────────────────────────────────────────
FROM ghcr.io/astral-sh/uv:python3.10-bookworm-slim

ENV PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_DOWNLOADS=never \
    UV_COMPILE_BYTECODE=1 \
    PATH=/opt/venv/bin:$PATH

RUN apt-get update && apt-get install -y --no-install-recommends \
        git libpq5 \
    && rm -rf /var/lib/apt/lists/*

# See Dockerfile.backend for notes on UID 1000 and required host chowns.
RUN groupadd --gid 1000 dalgouser && \
    useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash dalgouser

COPY --from=builder --chown=dalgouser:dalgouser /opt/venv /opt/venv

RUN mkdir -p /app && chown dalgouser:dalgouser /app

USER dalgouser

WORKDIR /app

EXPOSE 8002

CMD ["uvicorn", "ddpui.asgi:application", \
     "--host", "0.0.0.0", "--port", "8002", \
     "--reload", "--timeout-keep-alive", "60"]
