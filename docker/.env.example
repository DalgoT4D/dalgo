# Docker Compose overrides — copy to .env and uncomment what you need.
# Service-level config (DB, Redis, API keys, etc.) lives in each service's own .env.

# Image tags (prod only — dev always builds :dev images locally)
# BACKEND_IMAGE_TAG=latest
# PROXY_IMAGE_TAG=latest
# LLM_IMAGE_TAG=latest
# WEBAPP_IMAGE_TAG=latest

# Host ports
# BACKEND_HOST_PORT=8002
# PROXY_HOST_PORT=8080
# WEBAPP_HOST_PORT=3001
# LLM_HOST_PORT=7001
# REDIS_HOST_PORT=6370   # dev only — Redis is not exposed in prod

# Dev secrets (dev only — path to local warehouse credential files)
# DEV_SECRETS_HOST_PATH=/path/to/secrets/DEV_SECRETS

# Client dbt projects — must be the same path on host and in container
# (paths are stored as absolute in Prefect deployments and the Django DB)
CLIENTDBT_ROOT_MOUNT=/path/to/clients_dbt
DBT_VENV_MOUNT=/path/to/dalgo_dbt_venv
