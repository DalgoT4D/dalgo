# ── Builder ───────────────────────────────────────────────────────────────────
FROM ghcr.io/astral-sh/uv:python3.10-bookworm-slim AS builder

ENV PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_DOWNLOADS=never \
    UV_COMPILE_BYTECODE=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential libpq-dev git \
    && rm -rf /var/lib/apt/lists/*

COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-install-project

COPY backend/ .
RUN uv sync --frozen

# ── Runtime ───────────────────────────────────────────────────────────────────
FROM ghcr.io/astral-sh/uv:python3.10-bookworm-slim

ENV PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_DOWNLOADS=never \
    PATH=/opt/venv/bin:$PATH

RUN apt-get update && apt-get install -y --no-install-recommends \
        git libpq5 \
    && rm -rf /var/lib/apt/lists/*

# dalgouser is pinned to UID/GID 1000 so files written to bind-mounted host
# directories (CLIENTDBT_ROOT_MOUNT, DEV_SECRETS_HOST_PATH) have predictable
# ownership. On the server, those host paths must be owned by 1000:1000:
#   sudo chown -R 1000:1000 <CLIENTDBT_ROOT_MOUNT>
#   sudo chown -R 1000:1000 <DEV_SECRETS_HOST_PATH>
RUN groupadd --gid 1000 dalgouser && \
    useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash dalgouser

COPY --from=builder --chown=dalgouser:dalgouser /opt/venv /opt/venv
COPY --from=builder --chown=dalgouser:dalgouser /app /app

USER dalgouser

WORKDIR /app

EXPOSE 8002

CMD ["uv", "run", "uvicorn", "ddpui.asgi:application", \
     "--workers", "1", \
     "--host", "0.0.0.0", \
     "--port", "8002", \
     "--timeout-keep-alive", "60"]
