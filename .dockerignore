# Env files — provided via docker-compose env_file at runtime, never baked in.
**/.env
**/.env.*
!**/.env.template
!**/.env.example

# VCS
.git
.gitignore

# Python
**/__pycache__
**/*.pyc
**/.venv
**/.pytest_cache
**/.mypy_cache
**/*.egg-info

# Node
**/node_modules
**/.next

# Local artifacts
**/celerybeat-schedule*
**/*.log
.sync-cache/
.sync-state
